# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Skills/agent tooling installed locally (npx skills add / npx plugins add) —
# editor config, not site source.
/.agents/
/.claude/
skills-lock.json

# Scratch artifacts from the redesign audit (screenshots, content diffs) —
# process output, not part of the deployed site.
/_redesign/
